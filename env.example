# =====================================================================
# 환경변수 예시 — 이 파일을 .env 로 복사해서 값을 채우세요.
#   cp .env.example .env
# .env 는 절대 git에 커밋하지 마세요 (.gitignore에 포함되어 있음).
# =====================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=qa_scope
MYSQL_USER=qa_user
MYSQL_PASSWORD=change_me_user
MYSQL_PORT=3306

# --- ChromaDB ---
CHROMA_PORT=8000

# --- Backend ---
BACKEND_PORT=4000
# 채점·교차검증에 쓰는 Anthropic API 키
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# 저점수 상태라벨 기준선 (DB app_config가 정본, 이 값은 부팅 폴백)
LOW_SCORE_CUT=70

# --- Frontend ---
FRONTEND_PORT=3000
