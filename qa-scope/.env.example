# ===== LLM =====
# 프로바이더 선택: gemini | claude
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=

# Claude (2단계 이후 교체 시 사용)
# ANTHROPIC_API_KEY=

# 모델명 (평가메타에 주입)
LLM_MODEL=gemini-2.5-flash

# 재현성을 위해 낮게 유지 (0.0~0.3 권장)
LLM_TEMPERATURE=0.1

# ===== 채점 파라미터 =====
# 컷 점수 — 하드코딩 금지, 여기서만 조정
SCORE_CUTOFF=70

# ===== 저장 =====
# 1단계: 로컬 파일 저장 경로
RESULTS_DIR=./results

# 2단계 이후 MySQL
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=qa_user
# DB_PASSWORD=
# DB_NAME=qa_scope

# ===== RAG (2단계 이후) =====
# CHROMA_URL=http://localhost:8000

# ===== 루브릭 버전 (평가메타 주입용) =====
RUBRIC_VERSION=v1.5
