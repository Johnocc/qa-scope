# ===== LLM =====
# 프로바이더 선택: gemini | claude
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=

# Claude (2단계 이후 교체 시 사용)
# ANTHROPIC_API_KEY=

# 모델명 (평가메타에 주입)
LLM_MODEL=gemini-2.5-flash

# 재현성을 위해 낮게 유지 (0.0~0.3 권장)
LLM_TEMPERATURE=0.1

# ===== 채점 파라미터 =====
# 컷 점수 — 하드코딩 금지, 여기서만 조정
SCORE_CUTOFF=70
LOW_SCORE_CUT=70

# ===== 저장 =====
# 1단계: 로컬 파일 저장 경로
RESULTS_DIR=./results

# ===== Docker Compose 포트 매핑 =====
# 호스트에 로컬 MySQL이 있으면 3306이 충돌하므로 3307 등 다른 포트로 지정.
MYSQL_PORT=3307
APP_PORT=3000
CHROMA_PORT=8000

# ===== MySQL 컨테이너 (docker-compose가 참조) =====
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=qa_scope
MYSQL_USER=qa_user
MYSQL_PASSWORD=

# ===== 호스트에서 직접 스크립트 실행 시 DB 접속 (scripts/apply-schema.js 등) =====
# 호스트→컨테이너 접근이므로 MYSQL_PORT와 같은 값을 쓴다.
DB_HOST=localhost
DB_PORT=3307
DB_USER=qa_user
DB_PASSWORD=
DB_NAME=qa_scope

# ===== RAG (2단계 이후) =====
# CHROMA_URL=http://localhost:8000

# ===== 루브릭 버전 (평가메타 주입용) =====
RUBRIC_VERSION=v1.5
