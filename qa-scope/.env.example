# ===== LLM =====
# 프로바이더 선택: gemini | claude
LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=

# Claude (2단계 이후 교체 시 사용)
# ANTHROPIC_API_KEY=

# 모델명 (평가메타에 주입)
LLM_MODEL=gemini-2.5-flash

# 재현성을 위해 낮게 유지 (0.0~0.3 권장)
LLM_TEMPERATURE=0

# ===== 채점 파라미터 =====
# 컷 점수 — 하드코딩 금지, 여기서만 조정
LOW_SCORE_CUT=70

# ===== 저장 =====
# 1단계: 로컬 파일 저장 경로
RESULTS_DIR=./results

# ===== Docker Compose 포트 매핑 =====
# 호스트에 로컬 MySQL이 있으면 3306이 충돌하므로 3307 등 다른 포트로 지정.
MYSQL_PORT=3307
APP_PORT=3000
CHROMA_PORT=8000

# ===== MySQL 컨테이너 (docker-compose가 참조) =====
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=qa_scope
MYSQL_USER=qa_user
MYSQL_PASSWORD=

# ===== 호스트에서 직접 스크립트 실행 시 DB 접속 (scripts/apply-schema.js 등) =====
# 호스트→컨테이너 접근이므로 MYSQL_PORT와 같은 값을 쓴다.
DB_HOST=localhost
DB_PORT=3307
DB_USER=qa_user
DB_PASSWORD=
DB_NAME=qa_scope

# ===== DB SSL/TLS (클라우드 MySQL — Aiven 등) =====
# 로컬 docker-compose는 평문이므로 false(기본). Aiven 접속 시 true로.
DB_SSL_ENABLED=false
# CA 인증서 주입 — 둘 중 하나만 쓰면 된다 (둘 다 있으면 PATH 우선):
#   DB_SSL_CA_PATH: Aiven 콘솔에서 받은 ca.pem 파일 경로 (로컬 실행용)
#   DB_SSL_CA: PEM 내용 자체 ("\n" 이스케이프 허용 — Vercel 등 env-only 환경용)
# DB_SSL_CA_PATH=./certs/aiven-ca.pem
# DB_SSL_CA=
# 서버 인증서 검증 끄기(비권장 — 디버깅용): false로 설정 시 검증 생략
# DB_SSL_REJECT_UNAUTHORIZED=true

# 세션 타임존 (기본 +09:00) — 클라우드 MySQL은 서버 기본이 UTC인 경우가 많아
# NOW()·DEFAULT CURRENT_TIMESTAMP가 어긋나지 않게 커넥션마다 고정한다.
# DB_TIME_ZONE=+09:00

# 커넥션 풀 크기 (기본 10). 서버리스 배포 시 3~5 권장 — 함수 인스턴스마다 풀이 생김.
# DB_POOL_SIZE=5

# 죽은 연결 방어 (원격 DB — Aiven 등). 로컬 Docker는 유휴 연결을 안 끊어 무관.
#  - DB_IDLE_TIMEOUT_MS: 풀이 유휴 연결을 폐기하는 시간(기본 30000=30초).
#    반드시 서버 wait_timeout보다 짧게 — 서버가 끊은 죽은 연결 재사용을 막는다.
#  - DB_KEEPALIVE_DELAY_MS: TCP keepalive 시작 지연(기본 10000=10초).
# DB_IDLE_TIMEOUT_MS=30000
# DB_KEEPALIVE_DELAY_MS=10000

# ===== RAG (Chroma) =====
# Chroma Cloud (배포 시) — 3개 모두 설정하면 CloudClient로 자동 전환
# 비워두면 로컬 Docker(localhost:8000)로 동작
# CHROMA_API_KEY=ck-...
# CHROMA_TENANT=...
# CHROMA_DATABASE=...

# RAG 스위치: 'true'일 때만 약관을 chroma 검색으로 가져옴 (기본: 꺼짐=약관 전체 하드코딩)
RAG_ENABLED=false

# ===== 루브릭 버전 (평가메타 주입용) =====
RUBRIC_VERSION=v1.5

# ===== 인증 (NextAuth / Auth.js v5) =====
# 로그인 설계문서 v1 + 보완사항 20260716([C]·[D] 확정)·CLAUDE.md §12 준수 — 모두 env로만.
#
# NEXTAUTH_SECRET: JWT 세션 쿠키 서명 키. 반드시 설정(없으면 세션 검증 불가).
#   [C 확정] 값은 John이 생성해 Vercel 환경변수에 등록 — 팀원은 Vercel 대시보드에서
#   확인해 로컬 .env에 옮겨 쓴다. ⚠ 코드·이 파일·디스코드에 값 기재 금지(변수명만).
#   (v5는 AUTH_SECRET ?? NEXTAUTH_SECRET 순으로 읽음 — 어느 이름이든 동작.
#    생성 방법 참고: npx auth secret / openssl rand -base64 33)
NEXTAUTH_SECRET=
# NEXTAUTH_URL: Vercel에는 John이 등록. 로컬은 자동 감지되어 대개 불필요.
# NEXTAUTH_URL=

# 시드 계정(qa_manager) 공급 — scripts/seed-user.ts 가 읽어 bcrypt 해시로 저장.
#   [D 확정] SEED_ADMIN_PASSWORD 없으면 에러로 중단(기본값 폴백 금지).
#   Vercel에는 넣지 않는다 — 시드 실행 시에만 필요.
SEED_ADMIN_USERNAME=qa_manager
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=QA 매니저
# bcrypt 해시 라운드(기본 10). 높일수록 안전하지만 느려짐.
# BCRYPT_SALT_ROUNDS=10

# 로그인 시도 제한(시간창) — 기본 5회/5분(설계문서 §6 확정 B). 조정 가능.
# AUTH_RATE_LIMIT_MAX=5
# AUTH_RATE_LIMIT_WINDOW_MS=300000
